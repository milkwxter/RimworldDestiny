<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- SAFE arc damage -->
<!-- increased movement! -->
<HediffDef>
		<defName>DS_Arc_Safe</defName>
		<label>arc proc (safe)</label>
		<description>This pawn is crackling with a safe amount of potent arc energy. Their movement is increased as their body surges with energy.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0, 1, 1)</defaultLabelColor>
		<isBad>False</isBad>
		<comps>
		  <li Class="HediffCompProperties_Disappears">
			<showRemainingTime>True</showRemainingTime>
			<disappearsAfterTicks>900</disappearsAfterTicks>
		  </li>
		</comps>
		<stages>
		<li>
            <capMods>
                <li>
                    <capacity>Moving</capacity>
                    <offset>0.2</offset>
                </li>
            </capMods>
        </li>
		</stages>
</HediffDef>

</Defs>